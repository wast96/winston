# Regenerable working files (rebuild from source.epub; never project work)
data/src_epub/
data/src/
data/verify/
data/figs/manifest.json
build/
__pycache__/
*.pyc

# Deliverable artifacts that rebuild from the sources
out/*.epub
out/*_bilingual.md
out/INGEST.md
out/SURVEY.md

# Draft structure emitted by ingest (you promote it into book.json)
book.draft.json

# Keep source.epub and committed figure images (data/figs/*.png|jpg) TRACKED.
# If your source EPUB is large and you would rather not commit it, add:
#   source.epub

# Scratch working files (English intermediates, check configs) — regenerable
/scratchpad/
/scratch/

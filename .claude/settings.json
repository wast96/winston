{
  "permissions": {
    "allow": [
      "ToolSearch",
      "PushNotification",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__github__get_file_contents"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/check_kickoff_pasted.py\"",
            "timeout": 20,
            "statusMessage": "Checking the next-batch kickoff message was pasted"
          }
        ]
      }
    ]
  }
}

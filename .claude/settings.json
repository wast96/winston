{
  "permissions": {
    "allow": [
      "Bash(python3 scripts/*)",
      "Bash(python3 tests/run_tests.py)",
      "Bash(pgrep *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(tesseract *)",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__delete_trigger"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/kickoff_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
